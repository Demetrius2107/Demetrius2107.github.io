# Hugo生成的文件
public/
.hugo_build.lock
resources/

# 备份目录
backup/

# 可执行文件
hugo.exe

# 依赖目录
node_modules/

# IDE文件
.vscode/
.idea/
*.swp
*.swo
*~

# Obsidian 本地配置（vault 根目录 = 仓库根目录，勿提交）
.obsidian/
.obsidianignore

# 操作系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.temp

# 敏感信息（CMS 登录 Token 等，禁止提交）
CMS token.md
*token*.md

# Obsidian 本地写作模板（不进仓库）
_templates/

# npm（实际 CMS 走 CDN，无前端依赖）
node_modules/
package-lock.json

# ZCode 工具生成的计划文件
.zcode/
